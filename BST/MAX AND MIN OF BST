class Solution {
    public int minValue(Node root) {
        // code here
        if(root==null) return -1;
        
        Node temp= root;
        
        while(temp.left!=null) temp= temp.left;
        
        return temp.data;
    }
    
      public int maxValue(Node root) {
        // code here
        if(root==null) return -1;
        
        Node temp= root;
        
        while(temp.right!=null) temp= temp.right;
        
        return temp.data;
    }
}
