class Solution {
    public void rotate(int[][] arr) {

// First transpose 
        
     for(int i=0; i<arr.length; i++){
        for(int j=0; j<i; j++){
            int temp= arr[i][j];
            arr[i][j]= arr[j][i];
            arr[j][i]= temp;
        }
     }

   // then reverse each row

        for(int i=0; i<arr.length; i++){
            int startCol= 0, endCol= arr[0].length-1;
          while(startCol<endCol){
            int temp= arr[i][startCol];
            arr[i][startCol]= arr[i][endCol];
            arr[i][endCol]= temp;
            startCol++;
            endCol--;
          }

        }

    }
}
