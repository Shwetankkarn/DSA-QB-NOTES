class Solution {
    public List<Integer> majorityElement(int[] vp) {

        List<Integer> list = new ArrayList<>();

        int n = vp.length;
        int count1 = 0;
        int ans1 = 999;

        int count2 = 0;
        int ans2 = 1;

        for (int i = 0; i < vp.length; i++) {

            if (vp[i] == ans1) {
                count1++;
            }

            else if (vp[i] == ans2) {
                count2++;
            }

            else if (count1 == 0) {
                ans1 = vp[i];
                count1 = 1;
            }

            else if (count2 == 0) {
                ans2 = vp[i];
                count2 = 1;
            }

            else{
                count1--;
            count2--;
            }

        }

        int freq1 = 0;
        int freq2 = 0;

        for (int i = 0; i < vp.length; i++) {
            if (ans1 == vp[i]) {
                freq1++;
            }
            if (ans2 == vp[i]) {
                freq2++;
            }
        }

        if (freq1 > n / 3) {
            list.add(ans1);
        }

        if (freq2 > n / 3) {
            list.add(ans2);
        }
        return list;
    }
}
