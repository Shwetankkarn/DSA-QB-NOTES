class Solution {
    public void rotate(int[] arr, int k) {
        
        int n= arr.length;
        if (n == 0) return;

         k= k%n;
          if (k == 0) return; 

        reverse(arr,0, n-1);
         reverse(arr,0, k-1);
          reverse(arr,k, n-1);

    }

    public static void reverse(int[]arr, int i, int j){
     
     while(i<j){
        int temp= arr[i];
        arr[i]= arr[j];
        arr[j]= temp;
        i++;
        j--;
     }

        

    }
}
