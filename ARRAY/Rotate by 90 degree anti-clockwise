class Solution {
    public void rotateMatrix(int[][] arr) {
        // code here
    
             for(int i=0; i<arr.length; i++){
                for(int j=0; j<i; j++){
                    int temp= arr[i][j];
                    arr[i][j]= arr[j][i];
                    arr[j][i]= temp;
                }
             }

                for(int i=0; i<arr[0].length; i++){
                int startRow = 0;
                int endRow = arr.length - 1;

                while (startRow < endRow) {

                    int temp = arr[startRow][i];
                    arr[startRow][i] = arr[endRow][i];
                    arr[endRow][i] = temp;

                    startRow++;
                    endRow--;
                  }

                }

            }
        }
    
