class Solution {

    static int[][] dp;

  public static int solve(int amount, int [] coins, int index){


   if(amount==0) return 1;

   if(amount<0) return 0;

   if(index>= coins.length) return 0;

   if(dp[amount][index]!=-1) return dp[amount][index];



   int coinpick= solve(amount-coins[index],coins,index);

   int coinskip= solve(amount,coins,index+1);

   return dp[amount][index] = coinpick + coinskip;


  }



    public int change(int amount, int[] coins) {
        
        int index=0;
        
        int n= coins.length;

        dp = new int[amount + 1][n];

        for(int i=0; i<dp.length; i++){
            for(int j=0; j<dp[i].length; j++){
            
           dp[i][j]=-1;


            }
        }

     

        return solve(amount,coins,0);


    }
}
