class Solution {

    static int[] dp;

    public static int f(int[] temp, int idx) {

        if (idx >= temp.length)
            return 0;

        if (dp[idx] != -1)
            return dp[idx];

        int pick = temp[idx] + f(temp, idx + 2);
        int skip = f(temp, idx + 1);

        dp[idx] = Math.max(pick, skip);

        return dp[idx];
    }

    public int deleteAndEarn(int[] nums) {

        int max = 0;

        for (int i = 0; i < nums.length; i++) {
            if (nums[i] > max) {
                max = nums[i];
            }
        }

        int[] temp = new int[max + 1];

        for (int i = 0; i < nums.length; i++) {
            temp[nums[i]] += nums[i];
        }

        dp = new int[temp.length];
        Arrays.fill(dp, -1);

        return f(temp, 0);
    }
}
