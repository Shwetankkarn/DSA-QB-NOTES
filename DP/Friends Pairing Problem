class Solution {
    public int countFriendsPairings(int n) {
        
 int[] dp = new int[n+1];
 
Arrays.fill(dp, -1);

  return friends(n,dp);
  
}

public static int friends(int n, int[] dp){
    
    if(n<=2) return n;
    if(dp[n]!=-1) return dp[n];
    
  return dp[n]= friends(n-1,dp)+ (n-1)*friends(n-2,dp);
    
}


// Method 2 tabulation

if (n <= 2) return n;

int[] dp = new int[n+1];


dp[1] = 1;
dp[2] = 2;


for(int i=3; i<dp.length; i++){
    
    
    
    dp[i]= dp[i-1]+ (i-1)*dp[i-2];
    
    
}

return dp[n];


}
}
