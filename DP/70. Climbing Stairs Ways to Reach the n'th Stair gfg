class Solution {

    static int[] dp;

   public static int stairs(int i, int n){

    if(i==n) return 1;
    if(i>n) return 0;
    if(dp[i]!=-1) return dp[i];

   return dp[i]= stairs(i+1,n)+ stairs(i+2,n);

   }



    public int climbStairs(int n) {

        dp= new int[n+1];

        Arrays.fill(dp,-1);

        return stairs(0,n);
    }
}

  // M-02 --> by tabulation

 public int countWays(int n) {

        if (n == 0) return 1;

        int[] dp = new int[n + 1];

        dp[0] = 1;
        dp[1] = 1;

        for (int i = 2; i <= n; i++) {
            dp[i] = dp[i - 1] + dp[i - 2];
        }

        return dp[n];
    }

}
