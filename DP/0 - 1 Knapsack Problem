class Solution {
    public int knapsack(int W, int val[], int wt[]) {
        // code here
        int n= wt.length;
        int[][] dp= new int[n][W+1];
        
        for(int i=0; i<dp.length; i++){
            for(int j=0; j<dp[0].length; j++){
                dp[i][j]=-1;
            }
        }
        return helper(0,W,val,wt,dp);
    }
    
    public static int helper(int i, int W, int val[], int wt[],int[][] dp){
        
        if(i==wt.length) return 0;
        if(dp[i][W]!=-1) return dp[i][W];
        
        int skip= helper(i+1,W,val,wt,dp);
        
        if(wt[i]>W) return dp[i][W]= skip;
        
        int pick= val[i]+ helper(i+1,W-wt[i],val,wt,dp);
        
        return dp[i][W]= Math.max(pick,skip);
        
        
    }
}
