class Solution {

  public static int solve(int[][]dp, int i, int j, StringBuilder s1, StringBuilder s2){

     if(i<0 || j<0) return 0;
     if(dp[i][j]!=-1) return dp[i][j];

     if(s1.charAt(i)==s2.charAt(j)) return dp[i][j]= 1+ solve(dp,i-1,j-1,s1,s2);

     else return dp[i][j]= Math.max(solve(dp,i-1,j,s1,s2),solve(dp,i,j-1,s1,s2));
    
  }



    public int longestPalindromeSubseq(String s) {

          int n = s.length();

     char[] arr= s.toCharArray();
     char[] rev= new char[n];

     for(int i=0; i<n; i++){
        rev[i]= arr[n-1-i];
     }

     String reverse= new String(rev);

     StringBuilder s1= new StringBuilder(s);
     StringBuilder s2= new StringBuilder(reverse);

     int m= s1.length();
     int p= s2.length();

     int [][] dp= new int[m][p];

     for(int i=0; i<dp.length; i++){
        for(int j=0; j<dp[i].length; j++){
            dp[i][j]=-1;
        }
     }


       return solve(dp,m-1,p-1,s1,s2);
    }
}
