class Solution {
    public int knapSack(int val[], int wt[], int capacity) {
        
        
        int[][] dp= new int[capacity+1][wt.length];
        
        for(int i=0; i<dp.length; i++){
            for(int j=0; j<dp[i].length; j++){
                dp[i][j]=-1;
            }
        }
        
        return helper(0,val,wt,capacity,dp);
    }
    
    public static int helper(int i, int[] val,int wt[], int capacity,int[][]dp){
        
        if(i==wt.length) return 0;
        if(dp[capacity][i]!=-1) return dp[capacity][i];
        
        
        int skip= helper(i+1,val,wt,capacity,dp);
        
        if(wt[i]>capacity) return dp[capacity][i]= skip;
        
        int pick= val[i] + helper(i,val,wt,capacity-wt[i],dp);
        
        return dp[capacity][i]= Math.max(pick, skip); 
        
    }
}
