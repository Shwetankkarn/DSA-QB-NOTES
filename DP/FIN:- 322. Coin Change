// BY UNBOUND KNAPSACK CONCEPT -> METHOD 01

class Solution {
    public int minCoins(int coins[], int sum) {
        // code here
        if(sum==0) return 0;
        
        int[][] dp= new int[coins.length][sum+1];
        
        int ans= helper(0,coins,sum,dp);
        
        return (ans!=Integer.MAX_VALUE) ? ans : -1;
    }
    
    public static int helper(int i, int[]coins, int sum,int[][]dp){
        
      if(i==coins.length) {
          
          if(sum==0) return 0;
          else return Integer.MAX_VALUE;
          
      }
      
      if(dp[i][sum]!=0) return dp[i][sum];
      
        
        int skip= helper(i+1,coins,sum,dp);
        
        if(coins[i]>sum) return dp[i][sum]= skip;
        
        int take= helper(i,coins,sum-coins[i],dp);
        
        
        int pick= (take==Integer.MAX_VALUE)? take: take+1;
        
        return dp[i][sum]= Math.min(pick, skip);
        
    }
}



// method 2

class Solution {

    int max = 1000000;

    public int coinChange(int[] coins, int amount) {

    int[][] dp = new int[amount + 1][coins.length];

    for(int i=0; i<dp.length; i++){
    for(int j=0; j<dp[i].length; j++){
        dp[i][j]=-1;
    }

    }

     

        int ans = solve(dp,coins, amount, 0);

        if (ans >= max) {
            return -1;
        } else {
            return ans;
        }
    }

    int solve(int[][]dp,int[] coins, int amount, int idx) {

        if (amount == 0) return 0;

        if (amount < 0) return max;


        if (idx == coins.length) return max;

        if(dp[amount][idx]!=-1) return dp[amount][idx];

        int take = max;
        if (coins[idx] <= amount) {
            take = 1 + solve(dp,coins, amount - coins[idx], idx);
        }

        int skip = solve(dp,coins, amount, idx + 1);

        dp[amount][idx] = Math.min(take, skip);

      return  dp[amount][idx];
    }
}
