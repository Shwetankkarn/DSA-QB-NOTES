class Solution {
    
    public int paths(int[][] dp, int m, int n){
        
        if(m==1 || n==1) return 1;
        
        if(dp[m][n]!=-1) return dp[m][n];
        
        return dp[m][n]= paths(dp,m-1,n)+ paths(dp,m,n-1);
        
        
        
    }
    
    
    
    public int numberOfPaths(int m, int n) {
        // code here
        int[][] dp= new int[m+1][n+1];
        
         for (int[] row : dp) {
            Arrays.fill(row, -1);
        }
        
        return paths(dp,m,n);
        
        
        
    }
    
    
    // M-02 --> BY TABULATION
    
    
    public int numberOfPaths(int m, int n) {
        
        int [][] dp = new int[m][n];
        
        for(int i=0; i<m; i++){
            for(int j=0; j<n; j++){
                if(i==0|| j==0) dp[i][j]=1;
                else dp[i][j]= dp[i-1][j]+dp[i][j-1];
            }
        }
        
        return dp[m-1][n-1];
        
    }
    
    
}
