class Solution {
    public static char getMaxOccuringChar(String s) {
        // code here
        
        char[] arr= s.toCharArray();
        
        int freq=0;
        int maxfreq= -1;
        char ans = arr[0];
        
        
        Arrays.sort(arr);
        
        int i=0, j=0;
        
        while(j<arr.length){
            if(arr[i]==arr[j]){
                j++;
            }
            else{
                freq=(j-i);
                
                if(freq>maxfreq){
                    maxfreq= freq;
                    ans= arr[i];
                    
                    
                }
                
                i=j;
            }
        }
        
          freq=(j-i);
                
                if(freq>maxfreq){
                    maxfreq= freq;
                    ans= arr[i];
                    
                    
                }
            
          return ans;
    }
}
