class Solution {
    public int reverseDegree(String s) {

        int sum= 0;
     
     for(int i=0; i<s.length(); i++){
     
     char ch= s.charAt(i);

     int asciiValue = (int) ch;

     int originalidx= 27-(asciiValue- 96);

     sum= sum+ (originalidx*(i+1));


     }

       return sum;


    }
}
