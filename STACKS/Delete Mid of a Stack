class Solution {
    public void deleteMid(Stack<Integer> st) {

        ArrayList<Integer> arr = new ArrayList<>();

        while (!st.isEmpty()) {
            arr.add(st.pop());
        }

        int mid = arr.size() / 2;
        arr.remove(mid);

        for (int i = arr.size() - 1; i >= 0; i--) {
            st.push(arr.get(i));
        }
    }
}
