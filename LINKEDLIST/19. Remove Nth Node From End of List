class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
          int length=0;
 
        ListNode temp= head;

        while(temp!=null){
            temp= temp.next;
            length++;
        }
        
   if(n == length){
        return head.next;
    }
     

         temp= head;

        for(int i=1; i<length-n; i++){
          
       temp= temp.next;


        }
        temp.next= temp.next.next;

        return head;
    }
}

// METHOD 2

class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {

        if(head == null){
            return null;
        }

        ListNode slow = head;
        ListNode fast = head;

        // fast ko n steps aage le jao
        for(int i = 0; i < n; i++){

            if(fast == null){
                return head;   // n > length
            }

            fast = fast.next;
        }

        // n == length
        if(fast == null){
            return head.next;
        }

        // slow ko previous node tak le jao
        while(fast.next != null){
            slow = slow.next;
            fast = fast.next;
        }

        // node delete
        slow.next = slow.next.next;

        return head;
    }
}
