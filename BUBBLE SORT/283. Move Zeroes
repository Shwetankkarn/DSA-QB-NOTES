// METHOD 01


class Solution {
    public void moveZeroes(int[] arr) {
        
        int i=0, j=0;

        while(j<arr.length){
            if(arr[j]==0) j++;
            else{
                  int temp= arr[i];
                    arr[i]= arr[j];
                    arr[j]= temp;
                  i++;
                  j++;
            }
        }
       
    }
}

TIME COMPLEXITY:- O(n)


// METHOD 2


class Solution {
    public void moveZeroes(int[] arr) {
        
        int n= arr.length;

        for(int i=0; i<n-1;i++){
            int swap=0;
            for(int j=0; j<n-1-i; j++){
                if(arr[j]==0) {
                    int temp= arr[j];
                    arr[j]= arr[j+1];
                    arr[j+1]= temp;
                }
                swap++;
            }
            if(swap==0) return;
            
        }
    }
}

TIME COMPLEXITY:- O(n^2)
