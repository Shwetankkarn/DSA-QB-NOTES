class Solution {
    public Queue<Integer> reverseFirstK(Queue<Integer> q, int k) {
        // code here
        
        int n= q.size();
        
        if (k > n || k <= 0) {
            return q;
        }

        Stack<Integer> st= new Stack<>();
        while(st.size()<k){
            st.push(q.remove());
        }
        while(st.size()>0){
            q.add(st.pop());
        }
        for(int i=1; i<=n-k; i++){
            q.add(q.remove());
        }
        
          return q;
    }
}
