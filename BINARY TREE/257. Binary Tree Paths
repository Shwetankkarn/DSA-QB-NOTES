class Solution {
    public List<String> binaryTreePaths(TreeNode root) {

        List<String> ans= new ArrayList<>();

        if(root==null) return ans;

        List<Integer> list= new ArrayList<>();
         
        paths(root,ans,list);

        return ans;
    }

    public static void paths(TreeNode root, List<String> ans,List<Integer> list){

          if(root == null) return;

         list.add(root.val);

     if(root.left==null && root.right==null){

          String path = "";

            for (int i = 0; i < list.size(); i++) {

                path += list.get(i);

                if (i != list.size() - 1) {
                    path += "->";
                }
            }
      
          ans.add(path);

       list.remove(list.size()-1);

       return;

     }

     paths(root.left,ans,list);

     paths(root.right,ans,list);

    list.remove(list.size()-1);




    }
}
