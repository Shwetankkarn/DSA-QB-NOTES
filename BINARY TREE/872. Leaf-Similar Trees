class Solution {
    public boolean leafSimilar(TreeNode root1, TreeNode root2) {

        List<Integer> arr1= new ArrayList<>();

        List<Integer> arr2= new ArrayList<>();
        
       similar1(root1,arr1);
        similar2(root2,arr2);

        return arr1.equals(arr2);

    }
    public static void similar1(TreeNode root1, List<Integer> arr1){

        if(root1==null) return;

        if(root1.left==null && root1.right==null){
         arr1.add(root1.val);
         return;
        }

    similar1(root1.left,arr1);
     similar1(root1.right,arr1);



    }

     public static void similar2(TreeNode root2, List<Integer> arr2){

        if(root2==null) return;

        if(root2.left==null && root2.right==null){
         arr2.add(root2.val);
         return;
        }

    similar2(root2.left,arr2);
     similar2(root2.right,arr2);



    }
}
