class Solution {
    public int minDepth(TreeNode root) {

         if (root == null) return 0;
        
     int depth=1;

     Queue<TreeNode> q= new LinkedList<>();

     q.add(root);

   while(!q.isEmpty()){

   int size= q.size();

   for(int i=0; i<size; i++){

   TreeNode front= q.remove();

   if(front.left==null && front.right==null){

    return depth;

   }

  if(front.left!=null){
    q.add(front.left);
  }

  if(front.right!=null){
    q.add(front.right);
  }



   }

   depth++;

  


   }
    return depth;
}
}
