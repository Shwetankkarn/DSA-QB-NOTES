class Solution {
    public long maximumSubarraySum(int[] arr, int k) {

        long maxSum = 0;
        long sum = 0;

        HashSet<Integer> set = new HashSet<>();

        int i = 0;
        int j = 0;

        while(j < arr.length) {

            while(set.contains(arr[j])) {
                set.remove(arr[i]);
                sum = sum - arr[i];
                i++;
            }

            set.add(arr[j]);
            sum = sum + arr[j];

            if(j - i + 1 == k) {

                maxSum = Math.max(maxSum, sum);

                set.remove(arr[i]);
                sum = sum - arr[i];
                i++;
            }

            j++;
        }

        return maxSum;
    }
}
