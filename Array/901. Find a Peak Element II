class Solution {
    public int[] findPeakGrid(int[][] mat) {

        int m = mat.length;
        int n = mat[0].length;

        for (int i = 0; i < m; i++) {

            for (int j = 0; j < n; j++) {

                // Check left
                if (j > 0 && mat[i][j] < mat[i][j - 1]) {
                    continue;
                }

                // Check right
                if (j < n - 1 && mat[i][j] < mat[i][j + 1]) {
                    continue;
                }

                // Check up
                if (i > 0 && mat[i][j] < mat[i - 1][j]) {
                    continue;
                }

                // Check down
                if (i < m - 1 && mat[i][j] < mat[i + 1][j]) {
                    continue;
                }

                // Greater than all existing neighbors
                return new int[]{i, j};
            }
        }

        return new int[]{-1, -1};
    }
}
