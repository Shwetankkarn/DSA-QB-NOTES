class Solution {
    public int[] twoSum(int[] ele, int target) {
    
    HashMap<Integer,Integer> map= new HashMap<>();

    for(int i=0; i<ele.length; i++){

     if(!map.containsKey(target-ele[i])){
        map.put(ele[i],i);
     }

     else{
        return new int[] {map.get(target-ele[i]),i};
     }



    }

   return new int[] {};

     
    }
}
