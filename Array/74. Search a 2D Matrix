class Solution {
    public boolean searchMatrix(int[][] arr, int target) {
       
       int m= arr.length;
       int n= arr[0].length;

     int lo=0, hi= m*n-1;

     while(lo<=hi){

     int mid= (lo+(hi-lo)/2);
     
     int midRow= mid/n;

     int midCol= mid%n;

     if(arr[midRow][midCol]==target) return true;

     else if(arr[midRow][midCol]>target) hi= mid-1;

     else{
        lo= mid+1;
     }




     }

    return false;

    }
}





