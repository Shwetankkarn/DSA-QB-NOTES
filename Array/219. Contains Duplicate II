class Solution {

  // METHOD 1--> O(N) 

    public boolean containsNearbyDuplicate(int[] ele, int k) {
        
    HashMap<Integer,Integer> map= new HashMap<>();

    for(int i = 0; i < ele.length; i++){

   if(map.containsKey(ele[i])){

    if((i-map.get(ele[i])<=k)) return true;
   }
   
   map.put(ele[i],i);

    }
    return false;
}

}

