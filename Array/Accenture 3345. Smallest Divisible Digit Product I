class Solution {
    public int smallestNumber(int n, int t) {
        while (true) {
            int product = 1;
            int original = n;

            while (original > 0) {
                int digit = original % 10;
                product *= digit;
                original /= 10;
            }

            if (product % t == 0) {
                return n;
            }

            n++;
        }
    }
}

