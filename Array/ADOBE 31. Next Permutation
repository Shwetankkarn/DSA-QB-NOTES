class Solution {

public static void swap(int[] arr, int i, int pivot){

    int temp= arr[i];
    arr[i]= arr[pivot];
    arr[pivot]= temp;

}

    public void nextPermutation(int[] arr) {

        int n= arr.length;

        int piv=-1;

        int max= -1;
        
   for(int i=n-2; i>=0; i--){
    
    if(arr[i]<arr[i+1]){

     piv= i;

     break;
      

    }
    }
    
        if (piv != -1) {
            for (int l = n - 1; l > piv; l--) {
                if (arr[l] > arr[piv]) {
                    swap(arr, l, piv);
                    break;
                }
            }
        }
        
     int j= piv+1, k= n-1;

     while(j<k){

    swap(arr, j, k);

    j++;

    k--;



    


    }

 



    }
}
