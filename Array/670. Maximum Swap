class Solution {
    public int maximumSwap(int arr) {
        
        String str = Integer.toString(arr);

        int[] nums = new int[str.length()];

        for(int i = 0; i < str.length(); i++){
            nums[i] = str.charAt(i) - '0';
        }

        for(int i = 0; i < nums.length; i++){

            int j = i + 1;
            int max = -1;

            while(j < nums.length){

                if(nums[j] > nums[i]){
                    if(max == -1 || nums[j] >= nums[max]){
                        max = j;
                    }
                }

                j++;
            }

            if(max != -1){
                int temp = nums[i];
                nums[i] = nums[max];
                nums[max] = temp;
                break;
            }
        }

        int ans = 0;

        for(int i = 0; i < nums.length; i++){
            ans = ans * 10 + nums[i];
        }

        return ans;
    }
}
